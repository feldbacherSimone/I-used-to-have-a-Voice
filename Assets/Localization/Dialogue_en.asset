  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 262b28c9957ef034e8c517f2cdf8dec2, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 152597004288
    m_Localized: 'Fabian: ... today we''re gonna go to ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152643141632
    m_Localized: 'Em_Past: Mhm.'
    m_Metadata:
      m_Items: []
  - m_Id: 152643141633
    m_Localized: 'Fabian: ... you need to help with  ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152643141634
    m_Localized: 'Em_Past: Mhm.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335936
    m_Localized: 'Fabian: ... the lad ... sick, unfortunately ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335937
    m_Localized: 'Fabian: ... bummer, he''s always so hard at work!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335938
    m_Localized: 'Em_Past: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335939
    m_Localized: 'Fabian: Emmi, when you''re already looking around you might as
      well put on some music.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335940
    m_Localized: 'Em_Past: Hm? Oh sure!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335941
    m_Localized: 'Fabian: The CDs are in the glovebox'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335942
    m_Localized: 'Fabian: Just pick one. '
    m_Metadata:
      m_Items: []
  - m_Id: 152647335943
    m_Localized: 'Em_Past: Rock'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335944
    m_Localized: 'Fabian: Nothing against that.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335945
    m_Localized: 'Em_Past: Raggae'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335946
    m_Localized: 'Fabian: I haven''t had a vacation in a while ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335947
    m_Localized: 'Em_Past: Metal'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335948
    m_Localized: 'Fabian: I didn''t know you were into this kind of stuff!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335949
    m_Localized: 'Em_Past: Funky'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335950
    m_Localized: 'Fabian: Good choice! '
    m_Metadata:
      m_Items: []
  - m_Id: 152647335951
    m_Localized: 'Fabian: Just switch it off if you''re tired of listening. '
    m_Metadata:
      m_Items: []
  - m_Id: 152647335952
    m_Localized: 'Fabian: So Emmi, are you excited abou today?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335953
    m_Localized: 'Em_Past: *yawn* Too early for such feelings'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335954
    m_Localized: 'Em_Past: *yawn* Too early for such feelings'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335955
    m_Localized: 'Fabian: Spend less time making yourself pretty!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335956
    m_Localized: 'Fabian: Then you can sleep in.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335957
    m_Localized: 'Em_Past: A little, but that''s normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335958
    m_Localized: 'Em_Past: A little, but that''s normal.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335959
    m_Localized: 'Fabian: Ha! Michi likes saying that too.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335960
    m_Localized: 'Fabian: Don''t worry, there''s not a lot to do for you anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335961
    m_Localized: 'Em_Past: Why are you taking me on such short notice anyway?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335962
    m_Localized: 'Fabian: The boy, he''s out today, unfortunately.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335963
    m_Localized: 'Fabian: And it''s a good exercise for you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335964
    m_Localized: 'Em_Past: Michi''s out sick today?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335965
    m_Localized: 'Em_Past: Michi''s out sick today?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335966
    m_Localized: Fabian, No, no, his driving exam is today.
    m_Metadata:
      m_Items: []
  - m_Id: 152647335967
    m_Localized: 'Fabian: He wouldn''t let a cold bring him down.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335968
    m_Localized: 'Em_Past: So cool that I can be there!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335969
    m_Localized: 'Em_Past: So cool that I can be there!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335970
    m_Localized: 'Fabian: Maybe I''ll take you more often, if you''re good today.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335971
    m_Localized: 'Fabian: You''ve only been here for a week.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335972
    m_Localized: 'Em_Past: Three, actually ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335973
    m_Localized: 'Em_Past: Three, actually ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335974
    m_Localized: 'Fabian: Right. It''s easy to get confused with all that chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335975
    m_Localized: 'Em_Past: ... yeah.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335976
    m_Localized: 'Em_Past: ... yeah.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335977
    m_Localized: 'Fabian: Today you can go nuts - '
    m_Metadata:
      m_Items: []
  - m_Id: 152647335978
    m_Localized: 'Fabian: then you don''t have to sit in the office all the time.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335979
    m_Localized: 'Em_Past: The boss keeps giving me all this dry office work -'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335980
    m_Localized: 'Fabian: Take it as a compliment. You''re neat and tidy; Michi could
      never do it.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335981
    m_Localized: 'Fabian: He''s better as a handyman.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335982
    m_Localized: 'Em_Past: I can still load the eqipment.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335983
    m_Localized: 'Em_Past: I can still load the eqipment.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335984
    m_Localized: 'Fabian: All of the camera equipment?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335985
    m_Localized: 'Em_Past: I''m not even that neat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335986
    m_Localized: 'Em_Past: I''m not even that neat ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335987
    m_Localized: 'Fabian: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335988
    m_Localized: 'Em_Past: Is that a BlackMagic camera?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335989
    m_Localized: 'Fabian: Look at you knowing your stuff.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335990
    m_Localized: 'Fabian: Yes, for a short interview with a client.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335991
    m_Localized: 'Fabian: Michi could have shown you how it works, he''s been doing
      it for a while.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335992
    m_Localized: 'Em_Past: Do I get to use it, too?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335993
    m_Localized: 'Fabian: I''d have to talk to Andi about it; it''s his, you see.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335994
    m_Localized: 'Fabian: Better stick with photography.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335995
    m_Localized: 'Em_Past: Andi? I haven''t met him.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335996
    m_Localized: 'Fabian: A colleague. He''s self-employed as a videographer now
      and occasionally films for us.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335997
    m_Localized: 'Fabian: Maybe you can watch him sometime.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335998
    m_Localized: 'Em_Past: Making a living off of my filming, I want that someday.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647335999
    m_Localized: 'Fabian: Ambitious! I like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336000
    m_Localized: 'Fabian: We need more women in the industry anyway.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336001
    m_Localized: 'Fabian: It''s nice that girls have more confidence nowadays.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336002
    m_Localized: 'Fabian: Now look here, speak of the devil ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336003
    m_Localized: 'Fabian: Cheers, Andi, how''s the editing going!'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336004
    m_Localized: 'Fabian: The convention is next week, you kno-'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336005
    m_Localized: 'Andi: There you go again.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336006
    m_Localized: 'Andi: The video will be there before the convention, Eder -'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336007
    m_Localized: 'Andi: asking''s not gonna make it go faster.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336008
    m_Localized: 'Andi: But that''s not why I''m calling.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336009
    m_Localized: 'Fabian: Oh okay -- what''s up?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336010
    m_Localized: 'Andi: What did you do with the boy, finally replaced him?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336011
    m_Localized: 'Fabian: Michi?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336012
    m_Localized: 'Fabian: Nothing - '
    m_Metadata:
      m_Items: []
  - m_Id: 152647336013
    m_Localized: 'Fabian: why, how come?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336014
    m_Localized: 'Andi: The pictures recently, they''re made by you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336015
    m_Localized: 'Andi: Usually you don''t even manage a sharp image.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336016
    m_Localized: 'Andi: Neither he nor you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336017
    m_Localized: 'Andi: Have I become too expensive for the chicks in accounting,
      have you found someone cheaper, huh?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336018
    m_Localized: 'Fabian: Oh, no, that''s just temporary.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336019
    m_Localized: 'Fabian: We have some help over the summer.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336020
    m_Localized: 'Andi: Well he seems to be capable of some things, or at least more
      than you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336021
    m_Localized: 'Andi: Maybe the boy can finally learn something.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336022
    m_Localized: 'Fabian: She ... Emmi''s just an intern.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336023
    m_Localized: 'Fabian: But right model.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336024
    m_Localized: 'Fabian: Always punctual and tiday.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336025
    m_Localized: 'Fabian: And she''s nice too, just not that talkativ.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336026
    m_Localized: 'Andi: Would you look at that - '
    m_Metadata:
      m_Items: []
  - m_Id: 152647336027
    m_Localized: 'Andi: an intern ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336028
    m_Localized: 'Fabian: She''s helping me with the shoot today, -'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336029
    m_Localized: 'Fabian: If she does good work, maybe she might be something for
      you then, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336030
    m_Localized: 'Andi: Pff, sounds exciting.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336031
    m_Localized: 'Andi: What does she look like?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336032
    m_Localized: 'Fabian: What -'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336033
    m_Localized: 'Andi: Eder.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336034
    m_Localized: 'Andi: Don''t be like that, you''re a guy, too -'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336035
    m_Localized: 'Andi: is she pretty, too?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336036
    m_Localized: 'Andi: Something to look at?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336037
    m_Localized: 'Fabian: Oh, you know ... she''s next to me in the car.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336038
    m_Localized: 'Fabian: Ask her yourself.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336039
    m_Localized: 'Andi: !!-'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336040
    m_Localized: 'Andi: Oh'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336041
    m_Localized: 'Andi: Hehe, that was just a joke.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336042
    m_Localized: 'Em_Past: ... haha, I get it'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336043
    m_Localized: 'Em_Past: ... haha, I get it'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336044
    m_Localized: 'Em_Past: Do you like talking about 15-year-olds like that?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336045
    m_Localized: 'Em_Past: Go fuck yourself, Andi'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336046
    m_Localized: 'Fabian: Look, she''s got a sense of humour.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336047
    m_Localized: 'Fabian: But I''ve gotta go, lots of work.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336048
    m_Localized: 'Fabian: Andi, we''ll talk later about the edit.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336049
    m_Localized: 'Andi: --""--'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336050
    m_Localized: 'Fabian: Told you he was peculiar'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336051
    m_Localized: 'Em_Past: He''s an asshole.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336052
    m_Localized: 'Em_Past: He''s an asshole.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336053
    m_Localized: 'Em_Past: Why didn''t you say anthing?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336054
    m_Localized: 'Em_Past: Why didn''t you say anthing?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336055
    m_Localized: 'Em_Past: ... I noticed'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336056
    m_Localized: 'Em_Past: ... I noticed'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336057
    m_Localized: 'Fabian: But his videos are good, nothing to complain about there.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336058
    m_Localized: 'Fabian: You learn to get along.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336059
    m_Localized: 'Em_Past: Easy for you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336060
    m_Localized: 'Em_Past: Easy for you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336061
    m_Localized: 'Em_Past: I see.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336062
    m_Localized: 'Em_Past: I see.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336063
    m_Localized: 'Fabian: And at least you embarrassed him.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336064
    m_Localized: 'Fabian: He''s all talk.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336065
    m_Localized: 'Em_Past: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336066
    m_Localized: 'Em_Past: Do you really think I can help him out sometime?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336067
    m_Localized: 'Fabian: If you want,'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336068
    m_Localized: 'Fabian: then I can send the boy over with you.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336069
    m_Localized: 'Fabian: He''ll protect you, haha.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336070
    m_Localized: 'Em_Past: "those chicks from accounting," what did he mean by that?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336071
    m_Localized: 'Fabian: On company outings, Marian used to take a bunch of pictures.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336072
    m_Localized: 'Fabian: She had a lot of fun with it,'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336073
    m_Localized: 'Fabian: only as a hobby, though.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336074
    m_Localized: 'Em_Past: How much longer until we''re there?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336075
    m_Localized: 'Fabian: About 20 minutes.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336076
    m_Localized: 'Em_Present: I laughed'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336077
    m_Localized: 'Em_Present: That''s what you do in situations like that, right?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336078
    m_Localized: 'Em_Present: Humor'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336079
    m_Localized: 'Em_Present: Camaraderie'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336080
    m_Localized: 'Em_Present: not being petty'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336081
    m_Localized: 'Em_Present: I''m sure the guy would''ve done the same.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336082
    m_Localized: 'Em_Present: I work hard and I''ve learned a lot, that''s what matters.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336083
    m_Localized: 'Em_Present: But I look in the mirror and the man in my head asks'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336084
    m_Localized: 'Em_Present: Are you pretty enough, too?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336085
    m_Localized: 'Em_Present: If you''re not pretty'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336086
    m_Localized: 'Em_Present: and not nice ...'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336087
    m_Localized: 'Em_Present: What worth does your work have?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336088
    m_Localized: 'Em_Present: Pretty?'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336089
    m_Localized: 'Em_Present: I am, today, but what use is it'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336090
    m_Localized: 'Em_Present: I can never afford an attitude like that.'
    m_Metadata:
      m_Items: []
  - m_Id: 152647336091
